# KITTI → YOLO 포맷 변환
def convert_kitti_to_yolo(kitti_dir, output_dir):
    os.makedirs(f'{output_dir}/labels', exist_ok=True)
    os.makedirs(f'{output_dir}/images', exist_ok=True)
    
    # Class mapping
    class_map = {
        'Car': 0, 'Van': 0, 'Truck': 0,
        'Pedestrian': 1, 'Person_sitting': 1,
        'Cyclist': 2, 'Tram': 3, 'Misc': 4
    }
    
    label_dir = Path(kitti_dir) / 'label_2'
    image_dir = Path(kitti_dir) / 'image_2'
    
    for label_file in label_dir.glob('*.txt'):
        image_name = label_file.stem + '.png'
        image_path = image_dir / image_name
        
        if not image_path.exists():
            continue
            
        # Read image size
        img = cv2.imread(str(image_path))
        h, w = img.shape[:2]
        
        yolo_labels = []
        with open(label_file, 'r') as f:
            for line in f:
                parts = line.strip().split()
                if len(parts) < 15:
                    continue
                    
                cls_name = parts[0]
                if cls_name not in class_map:
                    continue
                    
                # KITTI bbox: x1, y1, x2, y2
                x1, y1, x2, y2 = map(float, parts[4:8])
                
                # Convert to YOLO format: x_center, y_center, width, height (normalized)
                x_center = ((x1 + x2) / 2) / w
                y_center = ((y1 + y2) / 2) / h
                bbox_w = (x2 - x1) / w
                bbox_h = (y2 - y1) / h
                
                cls_id = class_map[cls_name]
                yolo_labels.append(f"{cls_id} {x_center:.6f} {y_center:.6f} {bbox_w:.6f} {bbox_h:.6f}")
        
        # Save YOLO label
        with open(f'{output_dir}/labels/{label_file.stem}.txt', 'w') as f:
            f.write('\n'.join(yolo_labels))
        
        # Copy image
        shutil.copy(image_path, f'{output_dir}/images/{image_name}')

import shutil
convert_kitti_to_yolo('/content/kitti_detection/training', '/content/kitti_yolo')

# ============================================
# 2. YOLOv8 Configuration
# ============================================

data_yaml = {
    'path': '/content/kitti_yolo',
    'train': 'images',
    'val': 'images',
    'nc': 5,
    'names': ['car', 'pedestrian', 'cyclist', 'tram', 'misc']
}

with open('/content/kitti_data.yaml', 'w') as f:
    yaml.dump(data_yaml, f)

# ============================================
# 3. Fine-tune YOLOv8
# ============================================

model = YOLO('yolov8n.pt')  # Nano model for speed

results = model.train(
    data='/content/kitti_data.yaml',
    epochs=30,
    imgsz=640,
    batch=16,
    name='fsd_detection',
    patience=10,
    save=True,
    project='/content/drive/MyDrive/fsd_models'
)

print("Training complete!")

# ============================================
# 4. Export to ONNX
# ============================================

best_model = YOLO('/content/drive/MyDrive/fsd_models/fsd_detection/weights/best.pt')

best_model.export(
    format='onnx',
    imgsz=640,
    simplify=True,
    opset=11
)

print("ONNX model saved: detection.onnx")
